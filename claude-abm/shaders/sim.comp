// 3) scatter each per-agent buffer into tmp (the host copies tmp back).
#if defined(K_SCATTER_GENES) || defined(K_SCATTER_W1) || defined(K_SCATTER_W2)
#if defined(K_SCATTER_GENES)
#define WORDS NG
#define SRC(k) floatBitsToUint(genes[k])
#elif defined(K_SCATTER_W1)
#define WORDS W1_WORDS
#define SRC(k) w1[k]
#else
#define WORDS W2_WORDS
#define SRC(k) w2[k]
#endif
void main() {
	uint t = gidx();
	uint i = t / uint(WORDS);
	if (past_hwm(i) || pc.tick == 0xffffffffu) return;
	if ((agents[i].flags & F_ALIVE) == 0u) return;
	uint w = t % uint(WORDS);
	tmp[perm[i] * uint(WORDS) + w] = SRC(i * uint(WORDS) + w);
}
#endif

#ifdef K_SCATTER_CARRY
void main() {
	uint i = gidx();
	if (past_hwm(i) || pc.tick == 0xffffffffu) return;
	if ((agents[i].flags & F_ALIVE) == 0u) return;
	uvec4 cr = carry[i];
	uint j = perm[i] * 4u;
	tmp[j] = cr.x;
	tmp[j + 1u] = cr.y;
	tmp[j + 2u] = cr.z;
	tmp[j + 3u] = cr.w;
}
#endif

// The sort moves agents to other THINK chunks, which changes where they are in
// their interpolation. Rewrite each previous pose so the displayed pose carries on
// seamlessly under the new timing (and still ends at the current pose).
#ifdef K_SCATTER_PREV
float chunk_t(uint i) {
	uint chunks = max(player.chunks, 1u);
	uint chunk = min(i / ((uint(CAPACITY) + chunks - 1u) / chunks), chunks - 1u);
	return fract(player.phase - float(chunk) / float(chunks));
}

void main() {
	uint i = gidx();
	if (past_hwm(i) || pc.tick == 0xffffffffu) return;
	Agent a = agents[i];
	if ((a.flags & F_ALIVE) == 0u) return;
	uint j = perm[i];
	float heading;
	vec2 shown = smooth_pose(i, a, heading); // what is on screen now
	float t_new = chunk_t(j);
	vec4 pv = vec4(a.pos, a.heading, 0.0);
	if (t_new < 0.9) {
		// shown = prev' + (cur - prev') * t_new  =>  prev' = cur - (cur - shown) / (1 - t_new)
		vec2 back = tdelta(a.pos, shown) / (1.0 - t_new);
		float dh = mod(heading - a.heading + PI, 2.0 * PI) - PI;
		pv = vec4(wrap_pos(a.pos + back), a.heading + dh / (1.0 - t_new), 0.0);
	}
	tmp[j * 4u] = floatBitsToUint(pv.x);
	tmp[j * 4u + 1u] = floatBitsToUint(pv.y);
	tmp[j * 4u + 2u] = floatBitsToUint(pv.z);
	tmp[j * 4u + 3u] = floatBitsToUint(pv.w);
}
#endif

#ifdef K_SCATTER_AGENTS
void main() {
	uint i = gidx();
	if (past_hwm(i) || pc.tick == 0xffffffffu) return;
	Agent a = agents[i];
	if ((a.flags & F_ALIVE) == 0u) return;
	a.reg = NO_BUCKET;
	tmp_agents[perm[i]] = a;
}
#endif

// 4) after the copy-back: live agents are [0, N). Kill the tail, rebuild the free stack.
#ifdef K_SORT_TAIL
void main() {
	uint i = gidx();
	if (i >= uint(CAPACITY) || pc.tick == 0xffffffffu) return;
	uint n = uint(counters[6]);
	if (i >= n) {
		agents[i].flags = 0u;
		damage[i] = 0u;
	}
	gift[i] = 0u; // indices changed: pending gifts are dropped
	if (i < uint(CAPACITY) - n) free_stack[i] = uint(CAPACITY) - 1u - i;
	if (i == 0u) {
		counters[0] = CAPACITY - int(n);
		counters[1] = 0;
		counters[10] = counters[11];
	}
}
#endif

// 5) the grid for the next tick is rebuilt with the new indices (then REGISTER).
#ifdef K_CLEAR_GRID_W
void main() {
	uint b = gidx();
	if (b == 0u) counters[4] = counters[6];
	if (b < uint(NB) && pc.tick != 0xffffffffu) count_w[b] = 0;
}
#endif

// =============================================================================
// 3D explorer
// =============================================================================

// Pose shown between ticks: from the pose before the agent's last move to the
// current one. t is the time since the agent's THINK chunk ran, in ticks (0..1).
vec2 smooth_pose(uint i, Agent a, out float heading) {
	uint chunks = max(player.chunks, 1u);
	uint chunk = min(i / ((uint(CAPACITY) + chunks - 1u) / chunks), chunks - 1u);
	float t = fract(player.phase - float(chunk) / float(chunks));
	vec4 pv = prev[i];
	vec2 d = tdelta(pv.xy, a.pos);
	if (dot(d, d) > 1.0) { // newborn, teleported or stale: no interpolation
		heading = a.heading;
		return a.pos;
	}
	float dh = mod(a.heading - pv.z + PI, 2.0 * PI) - PI;
	heading = pv.z + dh * t;
	return wrap_pos(pv.xy + d * t);
}

// Start of a tick: make the player visible to agents (added to grid R, which the
// sort never reads) and execute the pending command.
#ifdef K_PLAYER
void main() {
	if (gidx() != 0u) return;
	if (player.presence != 0u) {
		// Register in every bucket within PLAYER_RANGE so agents there can notice us.
		int r = int(ceil(PLAYER_RANGE / float(BUCKET)));
		ivec2 b0 = bucket_coord(player.pos);
		uvec4 e = uvec4(PLAYER_ID, pack_pos(player.pos), player.presence_pheno, pack_ew(10.0, player.speed, 0u));
		for (int by = -r; by <= r; by++) {
			for (int bx = -r; bx <= r; bx++) {
				uint b = bucket_at(b0 + ivec2(bx, by));
				int k = atomicAdd(count_r[b], 1);
				if (k < SLOTS) slot_r[b * SLOTS + uint(k)] = e;
			}
		}
	}
	if (player.cmd == 0u || player.cmd_tick != pc.tick) return;
	uint t = player.target;
	bool valid = t < uint(CAPACITY) && (agents[t].flags & F_ALIVE) != 0u
			&& length(tdelta(agents[t].pos, player.target_pos)) < 8.0 * M2C + 1.0;
	if (player.cmd == CMD_KILL && valid) {
		agents[t].energy = -1.0; // dies (and leaves carrion) in THINK
	} else if (player.cmd == CMD_FEED && valid) {
		agents[t].energy += 4.0;
	} else if (player.cmd == CMD_SOW) {
		// Sow 24 young grass and flower plants within 8 m of the player.
		uint rs = pcg(pc.tick * 97u + pc.seed);
		for (int n = 0; n < 24; n++) {
			float ang = rnd(rs) * 2.0 * PI;
			vec2 p = player.pos + vec2(cos(ang), sin(ang)) * sqrt(rnd(rs)) * 8.0 * M2C;
			float st = rnd(rs) < 0.5 ? 0.1 : 0.33;
			vec4 A = vec4(st, 0.8, 0.0, rnd(rs));
			vec4 B = vec4(0.3, 0.2, rnd(rs), 0.3);
			plant_germinate(p, pack4(A), pack4(B), true, rs);
		}
	} else if (player.cmd == CMD_TRACK) {
		counters[10] = valid ? int(t) : -1;
	} else if (player.cmd == CMD_UNTRACK) {
		counters[10] = -1;
	}
}
#endif

// Selective breeding: clone the target (with mutation) into free slots.
#ifdef K_SPAWN
void main() {
	uint t = gidx();
	if (player.cmd != CMD_SPAWN || player.cmd_tick != pc.tick || t >= player.spawn_n) return;
	uint p = player.target;
	if (p >= uint(CAPACITY)) return;
	Agent pa = agents[p];
	if ((pa.flags & F_ALIVE) == 0u || length(tdelta(pa.pos, player.target_pos)) > 8.0 * M2C + 1.0) return;
	int k = atomicAdd(counters[1], 1);
	int free_n = counters[0];
	if (k >= free_n) return;
	uint slot = free_stack[free_n - 1 - k];
	uint rs = pcg(t * 7717u + pc.tick * 31u + pc.seed * 977u);
	inherit(slot, p, -1, rs);
	uint nn = (pa.flags & F_NN) != 0u ? 1u : 0u;
	float ang = rnd(rs) * 2.0 * PI;
	vec2 cp = wrap_pos(pa.pos + vec2(cos(ang), sin(ang)) * (1.0 + rnd(rs) * 3.0) * M2C);
	Agent ch;
	ch.pos = fert[cell_of(cp)] < 0.0 ? pa.pos : cp;
	ch.heading = rnd(rs) * 2.0 * PI;
	ch.energy = genes[slot * NG + G_REPRO] * 0.6;
	ch.age = 0.0;
	ch.flags = pa.flags & (F_ALIVE | F_NN);
	ch.pheno = pheno_of(slot, nn);
	ch.memory = 0.0;
	ch.generation = pa.generation + 1u;
	ch.action = A_WANDER;
	ch.speed = 0.0;
	ch.reg = NO_BUCKET;
	ch.uid = pcg(slot * 2654435761u ^ pc.tick * 40503u ^ pc.seed * 89u) | 1u;
	ch.parent_uid = pa.uid;
	ch.home = pack_pos(ch.pos);
	ch.food = NO_PLACE;
	gift[slot] = 0u;
	agents[slot] = ch;
	prev[slot] = vec4(ch.pos, ch.heading, 0.0);
	carry[slot] = uvec4(0u);
	damage[slot] = 0u;
	atomicMax(counters[4], int(slot) + 1);
	atomicAdd(counters[2], 1);
}
#endif

#ifdef K_VIS_RESET
void main() {
	if (gidx() != 0u || pc.tick == 0xffffffffu) return;
	counters[12] = 0;
	rb[0] = 0u;
}
#endif

// Agents around the player -> MultiMesh instances (+ a short list for picking).
#ifdef K_NEARBY
void main() {
	uint i = gidx();
	if (past_hwm(i) || pc.tick == 0xffffffffu) return;
	Agent a = agents[i];
	if ((a.flags & F_ALIVE) == 0u) return;
	float heading;
	vec2 p = smooth_pose(i, a, heading);
	vec2 f = vec2(cos(heading), sin(heading));
	vec2 d = tdelta(player.pos, p);
	float dd = dot(d, d);
	float vr = player.vis_radius * M2C;
	if (dd > vr * vr) return;
	vec2 wp = (player.pos + d) * CELL; // metres, unwrapped around the player
	float y = height_at(p);
	float s = 0.35 + ph_size(a.pheno) * 0.45;
	bool selected = i == player.target || int(i) == counters[10];
	uint k = uint(atomicAdd(counters[12], 1));
	if (k < uint(MAX_VIS)) {
		uint o = k * 20u;
		// Rows of the basis (x = (-fz, 0, fx), y = up, z = -forward) scaled by s, then origin.
		inst[o + 0u] = -f.y * s; inst[o + 1u] = 0.0; inst[o + 2u] = -f.x * s; inst[o + 3u] = wp.x;
		inst[o + 4u] = 0.0; inst[o + 5u] = s; inst[o + 6u] = 0.0; inst[o + 7u] = y;
		inst[o + 8u] = f.x * s; inst[o + 9u] = 0.0; inst[o + 10u] = -f.y * s; inst[o + 11u] = wp.y;
		vec3 col = agent_color(a, i);
		inst[o + 12u] = col.r; inst[o + 13u] = col.g; inst[o + 14u] = col.b; inst[o + 15u] = 1.0;
		inst[o + 16u] = ph_diet(a.pheno);
		inst[o + 17u] = float(a.action);
		inst[o + 18u] = a.speed;
		inst[o + 19u] = ((a.flags & F_NN) != 0u ? 1.0 : 0.0) + (selected ? 2.0 : 0.0);
	}
	float nr = player.near_radius * M2C;
	if (dd < nr * nr) {
		uint n = atomicAdd(rb[0], 1u);
		if (n < uint(MAX_NEAR)) {
			uint o = 64u + n * 8u;
			rb[o] = i;
			rb[o + 1u] = floatBitsToUint(wp.x);
			rb[o + 2u] = floatBitsToUint(y);
			rb[o + 3u] = floatBitsToUint(wp.y);
			rb[o + 4u] = floatBitsToUint(s);
			rb[o + 5u] = a.pheno;
			rb[o + 6u] = a.flags;
			rb[o + 7u] = a.action;
		}
	}
}
#endif

// Unused instances collapse to a zero-size transform.
#ifdef K_CLEAR_INSTANCES
void main() {
	uint k = gidx();
	if (k >= uint(MAX_VIS) || int(k) < min(counters[12], MAX_VIS)) return;
	for (uint j = 0u; j < 12u; j++) inst[k * 20u + j] = 0.0;
}
#endif

// Copy the aimed (or tracked) agent into the readback buffer.
#ifdef K_INSPECT
void main() {
	if (gidx() != 0u || pc.tick == 0xffffffffu) return;
	rb[3] = uint(counters[10]);
	rb[62] = uint(min(counters[12], MAX_VIS));
	for (int f = 0; f < 4; f++) rb[56 + f] = uint(min(counters[23 + f], MAX_PVIS));
	uint t = player.inspect_tracked != 0u ? uint(counters[10]) : player.target;
	bool ok = t < uint(CAPACITY) && (agents[t].flags & F_ALIVE) != 0u;
	if (ok && player.inspect_tracked == 0u) ok = length(tdelta(agents[t].pos, player.target_pos)) < 4.0;
	rb[2] = ok ? t : 0xffffffffu;
	if (!ok) return;
	Agent a = agents[t];
	float heading;
	vec2 sp = smooth_pose(t, a, heading);
	rb[4] = floatBitsToUint(sp.x);
	rb[5] = floatBitsToUint(sp.y);
	rb[6] = floatBitsToUint(heading);
	rb[7] = floatBitsToUint(a.energy);
	rb[8] = floatBitsToUint(a.age);
	rb[9] = a.flags;
	rb[10] = a.pheno;
	rb[11] = floatBitsToUint(a.memory);
	rb[12] = a.generation;
	rb[13] = a.action;
	rb[14] = floatBitsToUint(a.speed);
	rb[15] = floatBitsToUint(height_at(sp));
	for (uint q = 0u; q < uint(NG); q++) rb[16u + q] = floatBitsToUint(genes[t * NG + q]); // 16..32
}
#endif

// =============================================================================
// Plants
// =============================================================================

#ifdef K_INIT_PLANTS
void main() {
	uint k = gidx();
	if (k >= uint(PCAP)) return;
	uint n0 = min(uint(PINIT), uint(PCAP));
	if (k == 0u) {
		counters[16] = PCAP - int(n0);
		counters[17] = 0;
		counters[18] = 0;
		counters[19] = 0;
		counters[20] = int(n0);
		counters[22] = 0;
	}
	if (k >= n0) {
		pfree[uint(PCAP) - 1u - k] = k;
		plant_a[k] = uvec4(0u);
		plant_b[k] = uvec4(0u);
		return;
	}
	uint rs = pcg(k * 2246822519u + pc.seed * 7u + 3u);
	// A random land spot, denser on fertile ground.
	vec2 p = vec2(0.0);
	float f = -1.0;
	for (int t = 0; t < 32; t++) {
		p = vec2(rnd(rs), rnd(rs)) * float(WORLD);
		f = fert[cell_of(p)];
		if (f > 0.0 && rnd(rs) < f + 0.2) break;
	}
	if (f <= 0.0) { // no land found: stays dead (the first plant sort frees the slot)
		plant_a[k] = uvec4(0u);
		plant_b[k] = uvec4(0u);
		return;
	}
	// Lineages and growth forms occupy regions: forests on lush ground.
	vec2 uv = p / float(WORLD);
	uint salt = pc.seed * 7919u;
	float st = clamp(fbm(uv, 5, salt + 12000u) * 1.8 - 0.55 + (f - 0.5) * 0.5 + (rnd(rs) - 0.5) * 0.3, 0.0, 1.0);
	float hue = fract(fbm(uv, 3, salt + 9000u) * 2.5 + gauss(rs) * 0.02);
	vec4 A = vec4(st, 0.45 + 0.2 * rnd(rs), 0.12 * rnd(rs), hue);
	vec4 B = vec4(0.2 + 0.5 * rnd(rs), clamp(fbm(uv, 4, salt + 13000u) * 2.0 - 0.5, 0.0, 1.0),
			fract(hue * 1.7 + 0.1 * gauss(rs)), 0.2 + 0.3 * rnd(rs));
	float bmax = p_bmax(st, f);
	float bio = bmax * mix(0.3, 0.9, rnd(rs));
	uint age_u = uint(rnd(rs) * p_lifespan(st) * 0.6 / float(PSTRIDE));
	plant_a[k] = uvec4(pack_pos(p), uint(int(bio * PS)), pack4(A), pack4(B));
	plant_b[k] = uvec4(age_u | (packHalf2x16(vec2(bmax * 0.2, 0.0)) << 16), 0u, 0u,
			p_state(P_ALIVE, p_layer_of(st, p_height(st, bio / bmax)), 0u, 0u));
}
#endif

// Growth, light competition, flowering, wind pollination, reproduction and death
// for 1/PSTRIDE of the plants (a contiguous chunk, dt = PSTRIDE ticks).
#ifdef K_PLANT_TICK
void main() {
	uint chunk = (uint(PCAP) + PSTRIDE - 1u) / PSTRIDE;
	uint t = gidx();
	if (t >= chunk || pc.tick == 0xffffffffu) return;
	uint k = t + (pc.tick % PSTRIDE) * chunk;
	if (k >= uint(PCAP) || k >= uint(counters[20])) return;
	uvec4 pa = plant_a[k];
	uvec4 pb = plant_b[k];
	uint sb = pb.w;
	if ((sb & P_ALIVE) == 0u) return;
	uint rs = pcg(k * 747796405u + pc.tick * 2891336453u + pc.seed);
	vec4 A = unpack4(pa.z), B = unpack4(pa.w);
	vec2 pos = unpack_pos(pa.x);
	uint c = cell_of(pos);
	float f = max(fert[c], 0.02);
	float dt = float(PSTRIDE);
	float st = A.x;
	float bio = p_biomass(pa);
	uint age_u = (pb.x & 0xffffu) + 1u;
	float age = float(age_u) * dt;
	float reserve = unpackHalf2x16(pb.x >> 16).x;
	float bmax = p_bmax(st, f);
	uint layer = p_layer(sb);
	uint contrib = p_contrib(sb);

	// Energy budget. Every m2 of land gets pc.sun_energy per tick. The crown takes
	// what reaches its layer through the canopy above, shared out when its layer is
	// over-full, and small plants are also limited by their leaf mass (growth
	// gene). Respiration is paid on the living biomass (fast growers respire more,
	// wood less). The net goes to roots and shoots, up to the form's size.
	float light = p_light(c, layer);
	float crowd = float(cover[c * 3u + layer]) / 1000.0;
	float y = float(c / uint(WORLD)) / float(WORLD);
	float season = max(1.0 + pc.season_strength * sin(2.0 * PI * (float(pc.tick) / pc.season_length + y)), 0.0);
	float cr0 = p_crown(st, bio / bmax);
	float sun = dt * pc.sun_energy * season * light * PI * cr0 * cr0 / max(crowd, 1.0);
	float rgr = pc.plant_growth * (0.4 + 1.2 * A.y) * (1.0 - 0.6 * A.z) * (1.4 - st);
	float gross = min(sun, dt * rgr * (bio + 0.02));
	float net = gross - dt * 0.006 * bio * (0.6 + 0.8 * A.y) * (1.15 - st);
	if (net >= 0.0) {
		float to_root = net * B.w * 0.5;
		float shoot = min(net - to_root, max(bmax - bio, 0.0));
		bio += shoot;
		reserve = min(reserve + net - shoot, bmax * 0.5); // surplus is stored
	} else { // starving: live on the roots, then on the shoots
		float r = min(reserve, -net);
		reserve -= r;
		bio += net + r;
	}
	// GPU work of this update, paid in energy at the end (units ~ ns).
	float work = 3.0;
	// Resprout from the roots after being grazed down.
	if (bio < 0.25 * bmax && reserve > 0.0) {
		float r = min(reserve, dt * 0.01 * bmax);
		reserve -= r;
		bio += r;
	}

	// Death: old age, or nothing left above or below ground.
	if (age > p_lifespan(st) || (bio <= 0.002 && reserve <= 0.002)) {
		if (contrib > 0u) atomicAdd(cover[c * 3u + layer], -int(contrib));
		plant_a[k].y = 0u;
		plant_b[k].w = 0u;
		plists[atomicAdd(counters[22], 1)] = k;
		atomicAdd(counters[19], 1);
		return;
	}

	float fill = bio / bmax;
	bool mature = age > p_maturity(st) && fill > 0.5;
	// Each lineage flowers in its own part of the season (phase gene).
	bool flowering = mature && sin(2.0 * PI * (float(pc.tick) / pc.season_length + y - B.z)) > 0.3;
	uint flags = P_ALIVE | (sb & P_POLLINATED) | (flowering ? P_FLOWERING : 0u);
	uint fruit = p_fruit(sb);
	uvec2 donor = pb.yz;

	// Wind pollination by a compatible neighbour flowering at the same time.
	// Showy flowers mostly rely on animals instead.
	bool showy = st >= FORM_FLOWER && st < FORM_BUSH;
	if (flowering && (flags & P_POLLINATED) == 0u && rnd(rs) < (showy ? 0.15 : 1.0)) {
		ivec2 c0 = ivec2(floor(pos - 0.5));
		for (int dy = 0; dy <= 1 && (flags & P_POLLINATED) == 0u; dy++) {
			for (int dx = 0; dx <= 1 && (flags & P_POLLINATED) == 0u; dx++) {
				uvec2 r = pcell[cell_at(c0 + ivec2(dx, dy))];
				uint end = r.x + min(r.y, 16u);
				for (uint j = r.x; j < end; j++) {
					work += 0.2;
					if (j == k) continue;
					if ((plant_b[j].w & (P_ALIVE | P_FLOWERING)) != (P_ALIVE | P_FLOWERING)) continue;
					uvec4 q = plant_a[j];
					if (length(tdelta(pos, unpack_pos(q.x))) * CELL > 15.0) continue;
					if (p_dist(A, unpack4(q.z)) >= pc.mate_distance * 2.0) continue;
					donor = q.zw;
					flags |= P_POLLINATED;
					break;
				}
			}
		}
	}

	// Reproduction: mature plants in bloom spend a quarter of their biomass on
	// seeds (carried by the wind) or fruit (eaten and carried by animals).
	if (flowering && fill > 0.6 && rnd(rs) < dt * 0.02) {
		float spend = 0.25 * bio;
		bio -= spend;
		bool pollinated = (flags & P_POLLINATED) != 0u;
		float seed_cost = 0.03 + 0.3 * B.x;
		if (B.y > 0.5) {
			fruit = min(fruit + uint(spend / (seed_cost + 0.05)), 15u);
		} else {
			int n = min(int(spend / seed_cost), 4);
			for (int sd = 0; sd < n; sd++) {
				if (!pollinated && rnd(rs) > 0.35) continue; // self-pollinated seeds rarely work
				uvec2 child = plant_offspring(pa.zw, donor, pollinated, rs);
				float dist = (2.0 + 30.0 * (1.0 - B.x)) * rnd(rs); // small seeds fly further
				float ang = rnd(rs) * 2.0 * PI;
				plant_germinate(pos + vec2(cos(ang), sin(ang)) * dist * M2C, child.x, child.y, false, rs);
				work += 1.0;
			}
			flags &= ~P_POLLINATED;
		}
	}

	// Grasses (and, more slowly, flowers) also spread clonally (tillers, runners):
	// a new plant next to the parent, started with the biomass the parent puts
	// into it. No pollen needed, so they hold open ground where partners are scarce.
	float clonal = st < FORM_FLOWER ? 0.012 : (st < FORM_BUSH ? 0.004 : 0.0);
	if (clonal > 0.0 && age > p_maturity(st) && fill > 0.4 && rnd(rs) < dt * clonal) {
		float ang = rnd(rs) * 2.0 * PI;
		vec2 cp = wrap_pos(pos + vec2(cos(ang), sin(ang)) * (0.6 + 2.4 * rnd(rs)) * M2C);
		uint cc = cell_of(cp);
		float chance = p_light(cc, 0u) * clamp(1.4 - float(cover[cc * 3u]) / 1000.0, 0.0, 1.0);
		work += 1.0;
		if (fert[cc] > 0.0 && rnd(rs) < chance) {
			uvec2 child = plant_offspring(pa.zw, pa.zw, false, rs);
			float spend = 0.3 * bio;
			if (plant_place(cp, child.x, child.y, spend)) bio -= spend;
		}
	}

	// Pay for the GPU work, and report the energy flows.
	float compute = pc.compute_cost * work;
	bio = max(bio - compute, 0.0);
	flow_add(27, gross, 10.0);
	flow_add(28, compute, 1000.0);

	// Update what our crown adds to the canopy map.
	float h = p_height(st, bio / bmax);
	float cr = p_crown(st, bio / bmax);
	uint ncontrib = uint(clamp(PI * cr * cr / (CELL * CELL) * 1000.0, 0.0, 65535.0));
	uint nlayer = p_layer_of(st, h);
	if (nlayer != layer) {
		if (contrib > 0u) atomicAdd(cover[c * 3u + layer], -int(contrib));
		atomicAdd(cover[c * 3u + nlayer], int(ncontrib));
	} else if (ncontrib != contrib) {
		atomicAdd(cover[c * 3u + layer], int(ncontrib) - int(contrib));
	}
	plant_a[k].y = uint(int(max(bio, 0.0) * PS));
	plant_b[k] = uvec4(min(age_u, 65535u) | (packHalf2x16(vec2(reserve, 0.0)) << 16), donor,
			p_state(flags, nlayer, fruit, ncontrib));
}
#endif

// Plant free-stack bookkeeping (same scheme as the animals).
#ifdef K_PLANT_FINALIZE
void main() {
	uint t = gidx();
	if (t >= uint(counters[22]) || pc.tick == 0xffffffffu) return;
	int top = counters[16] - min(counters[17], counters[16]);
	pfree[top + int(t)] = plists[t];
}
#endif

#ifdef K_PLANT_COMMIT
void main() {
	if (gidx() != 0u || pc.tick == 0xffffffffu) return;
	counters[16] = counters[16] - min(counters[17], counters[16]) + counters[22];
	counters[17] = 0;
	counters[22] = 0;
}
#endif

// ---- Plant sort: counting sort of the plants by cell -> the per-cell index ----
#ifdef K_P_CLEAR_INDEX
void main() {
	uint c = gidx();
	if (c < uint(WORLD * WORLD) && pc.tick != 0xffffffffu) pcount[c] = 0u;
}
#endif

#ifdef K_P_COUNT
void main() {
	uint k = gidx();
	if (k >= uint(PCAP) || k >= uint(counters[20]) || pc.tick == 0xffffffffu) return;
	if ((plant_b[k].w & P_ALIVE) == 0u) return;
	pperm[k] = atomicAdd(pcount[cell_of(unpack_pos(plant_a[k].x))], 1u); // rank within the cell
}
#endif

#ifdef K_P_DEST
void main() {
	uint k = gidx();
	if (k >= uint(PCAP) || k >= uint(counters[20]) || pc.tick == 0xffffffffu) return;
	if ((plant_b[k].w & P_ALIVE) == 0u) return;
	pperm[k] += offsets[cell_of(unpack_pos(plant_a[k].x))];
}
#endif

#if defined(K_P_SCATTER_A) || defined(K_P_SCATTER_B)
void main() {
	uint k = gidx();
	if (k >= uint(PCAP) || k >= uint(counters[20]) || pc.tick == 0xffffffffu) return;
	if ((plant_b[k].w & P_ALIVE) == 0u) return;
#ifdef K_P_SCATTER_A
	uvec4 v = plant_a[k];
#else
	uvec4 v = plant_b[k];
#endif
	uint j = pperm[k] * 4u;
	tmp[j] = v.x;
	tmp[j + 1u] = v.y;
	tmp[j + 2u] = v.z;
	tmp[j + 3u] = v.w;
}
#endif

// Copy the sorted plants back from tmp (a compute pass, so the barriers between
// dispatches order it; only [0, N) holds sorted plants, the tail is cleared below).
#if defined(K_P_COPY_A) || defined(K_P_COPY_B)
void main() {
	uint k = gidx();
	if (k >= uint(counters[21]) || k >= uint(PCAP) || pc.tick == 0xffffffffu) return;
	uvec4 v = uvec4(tmp[k * 4u], tmp[k * 4u + 1u], tmp[k * 4u + 2u], tmp[k * 4u + 3u]);
#ifdef K_P_COPY_A
	plant_a[k] = v;
#else
	plant_b[k] = v;
#endif
}
#endif

// After the copy-back: live plants are [0, N) sorted by cell. Kill the tail and
// rebuild the free stack.
#ifdef K_P_TAIL
void main() {
	uint k = gidx();
	if (k >= uint(PCAP) || pc.tick == 0xffffffffu) return;
	uint n = uint(counters[21]);
	if (k >= n) {
		plant_a[k].y = 0u;
		plant_b[k].w = 0u;
	}
	if (k < uint(PCAP) - n) pfree[k] = uint(PCAP) - 1u - k;
	if (k == 0u) {
		counters[16] = PCAP - int(n);
		counters[17] = 0;
		counters[20] = int(n);
	}
}
#endif

// Rebuild the canopy map from the plants' stored contributions (after loading).
#ifdef K_P_COVER_ADD
void main() {
	uint k = gidx();
	if (k >= uint(PCAP) || k >= uint(counters[20]) || pc.tick == 0xffffffffu) return;
	uint sb = plant_b[k].w;
	if ((sb & P_ALIVE) == 0u || p_contrib(sb) == 0u) return;
	atomicAdd(cover[cell_of(unpack_pos(plant_a[k].x)) * 3u + p_layer(sb)], int(p_contrib(sb)));
}
#endif

// ---- 3D: plants around the player -> one MultiMesh per form ----
#ifdef K_P_VIS_RESET
void main() {
	uint f = gidx();
	if (f < 4u && pc.tick != 0xffffffffu) counters[23 + f] = 0;
}
#endif

void write_plant_instance(uint form, uint k, vec3 x, vec3 z, float sh, vec3 o, vec3 col, vec4 custom) {
	float v[20] = float[20](x.x, 0.0, z.x, o.x, 0.0, sh, 0.0, o.y, x.z, 0.0, z.z, o.z,
			col.r, col.g, col.b, 1.0, custom.x, custom.y, custom.z, custom.w);
	uint b = k * 20u;
	for (uint w = 0u; w < 20u; w++) {
		if (form == 0u) pinst0[b + w] = v[w];
		else if (form == 1u) pinst1[b + w] = v[w];
		else if (form == 2u) pinst2[b + w] = v[w];
		else pinst3[b + w] = v[w];
	}
}

// One thread per cell in a square around the player; it draws that cell's plants.
#ifdef K_P_NEARBY
void main() {
	int R = int(ceil(PLANT_VIEW * M2C));
	int S = 2 * R + 1;
	uint t = gidx();
	if (t >= uint(S * S) || pc.tick == 0xffffffffu) return;
	ivec2 cc = ivec2(floor(player.pos)) + ivec2(int(t % uint(S)), int(t / uint(S))) - R;
	uvec2 r = pcell[cell_at(cc)];
	uint end = r.x + min(r.y, 64u);
	for (uint j = r.x; j < end; j++) {
		uvec4 q = plant_a[j];
		uint qs = plant_b[j].w;
		if ((qs & P_ALIVE) == 0u) continue;
		vec2 pp = unpack_pos(q.x);
		vec2 d = tdelta(player.pos, pp);
		float dist = length(d) * CELL;
		vec4 A = unpack4(q.z);
		float st = A.x;
		uint form = st < FORM_FLOWER ? 0u : (st < FORM_BUSH ? 1u : (st < FORM_TREE ? 2u : 3u));
		float range = form == 0u ? 70.0 : (form == 1u ? 90.0 : (form == 2u ? 120.0 : PLANT_VIEW));
		if (dist > range) continue;
		uint k = uint(atomicAdd(counters[23 + int(form)], 1));
		if (k >= uint(MAX_PVIS)) continue;
		float fill = clamp(p_biomass(q) / p_bmax(st, max(fert[cell_of(pp)], 0.05)), 0.02, 1.0);
		// Model sizes: grass 0.5 m, flowers 0.6 m, bushes 1.2 m, trees 7.5 m tall.
		float base_h = form == 0u ? 0.5 : (form == 1u ? 0.6 : (form == 2u ? 1.2 : 7.5));
		float base_r = form == 0u ? 1.0 : (form == 1u ? 1.0 : (form == 2u ? 1.3 : 2.0));
		float sh = p_height(st, fill) / base_h;
		float sw = p_crown(st, fill) / base_r;
		float yaw = float(pcg(q.x) & 1023u) / 1023.0 * 2.0 * PI; // fixed per position
		vec3 x = vec3(cos(yaw), 0.0, -sin(yaw)) * sw;
		vec3 z = vec3(sin(yaw), 0.0, cos(yaw)) * sw;
		vec3 o = vec3((player.pos + d).x * CELL, height_at(pp), (player.pos + d).y * CELL);
		vec4 custom = vec4((qs & P_FLOWERING) != 0u ? 1.0 : 0.0, float(p_fruit(qs)) / 15.0,
				form == 3u && A.w > 0.5 ? 1.0 : 0.0, fract(0.72 + A.w * 0.5));
		write_plant_instance(form, k, x, z, sh, o, plant_leaf(A), custom);
	}
}
#endif

// Unused plant instances collapse to a zero-size transform.
#ifdef K_P_CLEAR_INST
void main() {
	uint t = gidx();
	uint form = t / uint(MAX_PVIS);
	uint k = t % uint(MAX_PVIS);
	if (form >= 4u || pc.tick == 0xffffffffu) return;
	if (int(k) < min(counters[23 + int(form)], MAX_PVIS)) return;
	write_plant_instance(form, k, vec3(0.0), vec3(0.0), 0.0, vec3(0.0), vec3(0.0), vec4(0.0));
}
#endif
