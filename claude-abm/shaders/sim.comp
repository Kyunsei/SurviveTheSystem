// =============================================================================
// Population statistics (read back asynchronously by the host). Each workgroup
// reduces into shared memory first, so global atomics stay cheap.
//  0 alive  1 utility  2 neural  3 herbivores  4 omnivores  5 carnivores
//  6 sum energy*10  7 sum size*1000  8 sum speed*1000  9 max generation
//  10..16 action counts  17 sum diet*1000  18 sum sense*1000  19 sum repro*10
//  20 sum mutation*1000  21 births  22 deaths  23 free slots  24 high-water mark
//  25 sum herbivore detox*1000  26 sampled live plants  27 sum plant growth*1000
//  28 sum plant defence*1000  29 sum plant fill (biomass / max)*1000  32..63 hue histogram
//  64..67 sampled grass / flowers / bushes / trees  68 pollinated  69 with fruit
//  70 fruit-dispersed  71 sum seed size*1000  72 flowering  73 plant sample stride
//  74 plant births  75 plant deaths  76 plant high-water mark
//  77..81 energy flows since the last read (see flow_add)
//  82..86 actions hide, care, mark, home, recall  87 calling  88 hiding  89 displaying
//  90 young with a parent  91 gifts to young  92 scent marks (since the last read)
#ifdef K_STATS
shared uint ls[96];
void main() {
	uint lt = gl_LocalInvocationID.x;
	if (lt < 96u) ls[lt] = 0u;
	barrier();
	uint i = gidx();
	if (i == 0u) {
		stats[21] = uint(counters[2]);
		stats[22] = uint(counters[3]);
		stats[23] = uint(counters[0]);
		stats[24] = uint(counters[4]);
		stats[74] = uint(counters[18]);
		stats[75] = uint(counters[19]);
		stats[76] = uint(counters[20]);
		stats[91] = uint(counters[13]); // gifts to young
		stats[92] = uint(counters[14]); // scent marks
		counters[13] = 0;
		counters[14] = 0;
		for (int k = 0; k < 5; k++) {
			stats[77 + k] = uint(counters[27 + k]);
			counters[27 + k] = 0;
		}
		counters[2] = 0;
		counters[3] = 0;
		counters[18] = 0;
		counters[19] = 0;
	}
	if (!past_hwm(i) && pc.tick != 0xffffffffu) {
		Agent a = agents[i];
		if ((a.flags & F_ALIVE) != 0u) {
			uint g = i * NG;
			float diet = genes[g + G_DIET];
			atomicAdd(ls[0], 1u);
			atomicAdd(ls[(a.flags & F_NN) != 0u ? 2 : 1], 1u);
			atomicAdd(ls[diet < 0.33 ? 3 : (diet < 0.66 ? 4 : 5)], 1u);
			atomicAdd(ls[6], uint(clamp(a.energy, 0.0, 100.0) * 10.0));
			atomicAdd(ls[7], uint(genes[g + G_SIZE] * 1000.0));
			atomicAdd(ls[8], uint(genes[g + G_SPEED] * 1000.0));
			atomicMax(ls[9], a.generation);
			if (a.action < 7u) atomicAdd(ls[10u + a.action], 1u); else atomicAdd(ls[82u + min(a.action - 7u, 4u)], 1u);
			if (flag_signal(a.flags) > 12u) atomicAdd(ls[87], 1u);
			if (flag_posture(a.flags) == POSTURE_HIDE) atomicAdd(ls[88], 1u);
			if (flag_posture(a.flags) == POSTURE_DISPLAY) atomicAdd(ls[89], 1u);
			if (a.age < YOUNG_AGE && a.parent_uid != 0u) atomicAdd(ls[90], 1u);
			atomicAdd(ls[17], uint(diet * 1000.0));
			atomicAdd(ls[18], uint(genes[g + G_SENSE] * 1000.0));
			atomicAdd(ls[19], uint(genes[g + G_REPRO] * 10.0));
			atomicAdd(ls[20], uint(genes[g + G_MUT] * 1000.0));
			atomicAdd(ls[32u + min(uint(ph_hue(a.pheno) * 32.0), 31u)], 1u);
			if (diet < 0.33) atomicAdd(ls[25], uint(genes[g + G_DETOX] * 1000.0));
		}
	}
	// Sample every stride-th plant for the plant averages.
	uint stride = max(16u, (uint(PCAP) + uint(CAPACITY) - 1u) / uint(CAPACITY));
	if (i == 0u) stats[73] = stride;
	uint pk = i * stride + (pc.tick % stride);
	if (pk < uint(counters[20]) && pc.tick != 0xffffffffu) {
		uvec4 q = plant_a[pk];
		uint qs = plant_b[pk].w;
		if ((qs & P_ALIVE) != 0u) {
			vec4 A = unpack4(q.z), B = unpack4(q.w);
			float st = A.x;
			atomicAdd(ls[26], 1u);
			atomicAdd(ls[27], uint(A.y * 1000.0));
			atomicAdd(ls[28], uint(A.z * 1000.0));
			atomicAdd(ls[29], uint(clamp(p_biomass(q) / p_bmax(st, max(fert[cell_of(unpack_pos(q.x))], 0.05)), 0.0, 1.0) * 1000.0));
			atomicAdd(ls[st < FORM_FLOWER ? 64 : (st < FORM_BUSH ? 65 : (st < FORM_TREE ? 66 : 67))], 1u);
			if ((qs & P_POLLINATED) != 0u) atomicAdd(ls[68], 1u);
			if (p_fruit(qs) > 0u) atomicAdd(ls[69], 1u);
			if (B.y > 0.5) atomicAdd(ls[70], 1u);
			atomicAdd(ls[71], uint(B.x * 1000.0));
			if ((qs & P_FLOWERING) != 0u) atomicAdd(ls[72], 1u);
		}
	}
	barrier();
	if (lt < 96u && (lt < 21u || lt > 24u) && (lt < 73u || lt > 76u) && ls[lt] != 0u) {
		if (lt == 9u) atomicMax(stats[9], ls[9]);
		else atomicAdd(stats[lt], ls[lt]);
	}
}
#endif

// =============================================================================
// Spatial sort (counting sort by bucket of grid W, which THINK/BIRTH just filled).
// 1) exclusive prefix sum of the bucket counts in three passes.
#if defined(K_PSCAN1) || defined(K_PSCAN2) || defined(K_PSCAN3)
#define SCAN_N uint(WORLD * WORLD)   // plants: one entry per cell
#define SCAN_IN(b) pcount[b]
#define SCAN_TOTAL 21
#else
#define SCAN_N uint(NB)              // agents: one entry per bucket of grid W
#define SCAN_IN(b) uint(count_w[b])
#define SCAN_TOTAL 6
#endif

#if defined(K_SCAN1) || defined(K_SCAN2) || defined(K_PSCAN1) || defined(K_PSCAN2)
shared uint sh[256];
void scan_shared(uint t) { // inclusive Hillis-Steele scan of sh[]
	for (uint off = 1u; off < 256u; off <<= 1) {
		uint x = t >= off ? sh[t - off] : 0u;
		barrier();
		sh[t] += x;
		barrier();
	}
}
#endif

#if defined(K_SCAN1) || defined(K_PSCAN1)
void main() {
	uint t = gl_LocalInvocationID.x;
	uint b = gidx();
	uint v = (b < SCAN_N && pc.tick != 0xffffffffu) ? SCAN_IN(b) : 0u;
	sh[t] = v;
	barrier();
	scan_shared(t);
	if (b < SCAN_N) offsets[b] = sh[t] - v;
	if (t == 255u) block_sums[b / 256u] = sh[255];
#ifdef K_SCAN1
	if (b == 0u) counters[11] = -1;
#endif
}
#endif

#if defined(K_SCAN2) || defined(K_PSCAN2)
void main() { // single workgroup: scan the block sums
	uint t = gl_LocalInvocationID.x;
	uint nblk = SCAN_N / 256u;
	uint per = (nblk + 255u) / 256u;
	uint sum = 0u;
	for (uint k = 0u; k < per; k++) {
		uint idx = t * per + k;
		if (idx < nblk) {
			uint v = block_sums[idx];
			block_sums[idx] = sum;
			sum += v;
		}
	}
	sh[t] = sum;
	barrier();
	scan_shared(t);
	uint prefix = sh[t] - sum;
	for (uint k = 0u; k < per; k++) {
		uint idx = t * per + k;
		if (idx < nblk) block_sums[idx] += prefix;
	}
	if (t == 255u && pc.tick != 0xffffffffu) counters[SCAN_TOTAL] = int(sh[255]);
}
#endif

#if defined(K_SCAN3) || defined(K_PSCAN3)
void main() {
	uint b = gidx();
	if (b >= SCAN_N || pc.tick == 0xffffffffu) return;
	offsets[b] += block_sums[b / 256u];
#ifdef K_PSCAN3
	pcell[b] = uvec2(offsets[b], pcount[b]); // the plant index for the next PLANT_SORT ticks
#endif
}
#endif

// 2) new index of every live agent.
#ifdef K_PERM
void main() {
	uint i = gidx();
	if (past_hwm(i) || pc.tick == 0xffffffffu) return;
	Agent a = agents[i];
	if ((a.flags & F_ALIVE) == 0u) return;
	perm[i] = atomicAdd(offsets[a.reg], 1u);
	if (counters[10] == int(i)) counters[11] = int(perm[i]);
}
