// =============================================================================
// Unified life - one kind of organism, bodies grown from a body-plan genome
// (GPU kernels).
//
// Compiled once per kernel by scripts/life/life_sim.gd. The host prepends
// "#version 450" and defines K_<NAME>, OCAP (organisms), LCAP (leg pool), BCAP
// (brain pool), WORLD (cells per side), CELL (metres per cell), BUCKET (cells per
// spatial-hash bucket), SLOTS (entries per bucket), NINIT and NMOB (initial
// organisms, of which mobile).
//
// Every organism has the same core (64 bytes): position, energy, age and
// development, flags, 16 life-history genes (core1) and a 16-gene body plan
// (core3). Plants and animals share one body grammar - an axis of segments with
// appendages, surfaces, feeding, protection and sensor modules - and differ by
// five continuous switches: anchorage (rooted .. free), axis (horizontal ..
// vertical), symmetry (bilateral .. radial), growth (indeterminate ..
// determinate) and actuation (rigid .. muscular). develop() turns genome, age
// and energy into abilities: movement = muscular appendages / anchorage,
// sunlight = surfaces, bite = feeding modules, and so on.
//
// Plant <-> animal transitions happen three ways: gradually (the switches drift
// every generation), suddenly (a rare switch mutation), and within a life
// (metamorphosis: at a genetic age anchorage and actuation take adult values, so
// a free larva can settle and root, or a rooted juvenile break free). Whenever a
// developed body crosses the movement threshold it takes legs (and a brain) from
// their pools, or gives them back.
//
// Only legs and brains need storage, and every pass only runs what a body has,
// so its GPU work - paid in energy (compute_cost) - follows its body: a rooted
// sun-eater is updated every 8 ticks for a few units, a brainy hunter every tick.
// =============================================================================

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// ---- Life-history genes (core1) ----------------------------------------------
#define G_SIZE 0      // body / stature
#define G_TEMP 1      // preferred temperature (climate niche)
#define G_BRAIN 5     // brain: number of neurons (x 8); only used while mobile
#define G_HUE 7       // lineage colour (neutral, used for kin recognition)
#define G_REPRO 8     // energy (share of capacity) needed to reproduce
#define G_CHILD 9     // share of energy given to each child
#define G_DISPERSE 10 // how far sessile offspring are spread
#define G_MUT 11      // mutation rate
#define G_CARNI 12    // what feeding modules eat: 0 plants (sessile) .. 1 animals and carrion
#define G_DETOX 13    // tolerance to defences
#define G_GROWTH 14   // growth tempo (fast growers respire more)
#define G_SOCIAL 15   // reflex attraction to kin
// (genes 2-4 and 6 of core1 are unused spares)

// ---- Body-plan genes (core3) -------------------------------------------------
#define M_ANCHOR 0        // switch: 0 free .. 1 rooted
#define M_AXIS 1          // switch: 0 horizontal (moves forward) .. 1 vertical (grows up)
#define M_SYM 2           // switch: 0 bilateral .. 1 radial
#define M_DETERM 3        // switch: 0 indeterminate (grows with energy) .. 1 determinate (adult form)
#define M_ACT 4           // switch: 0 rigid appendages (branches) .. 1 muscular (legs, tentacles)
#define M_SEGS 5          // axis segments: 1..6
#define M_APPS 6          // appendage pairs: 0..4
#define M_APPLEN 7        // appendage length
#define M_SURFACE 8       // surfaces: leaves / sails (photosynthesis)
#define M_FEED 9          // feeding modules: jaw / trap (mouth)
#define M_PROTECT 10      // protection: bark / armour / thorns
#define M_SENSOR 11       // sensors: eyes
#define M_SLENDER 12      // body / trunk thickness (visual, and a little mass)
#define M_META 13         // metamorphosis age (x 3000 ticks); below T_META: none
#define M_ADULT_ANCHOR 14 // anchorage after metamorphosis
#define M_ADULT_ACT 15    // actuation after metamorphosis

// Module thresholds: below them a module is absent (and costs nothing).
#define T_PHOTO 0.05
#define T_LEGS 0.1
#define T_MOUTH 0.05
#define T_EYES 0.1
#define T_BRAIN 0.125
#define T_META 0.1

#define BRAIN_WORDS 36   // 7 hidden x 4 words + 4 outputs x 2 words (int8 weights)
#define NONE 0xffffffffu
#define PSTRIDE 8u       // sessile organisms are updated every PSTRIDE ticks
#define FIELD_STRIDE 4
#define M2C (1.0 / CELL)
#define BW (WORLD / BUCKET)
#define NB (BW * BW)
#define DEAD_MAX (OCAP / 4)
#define BIRTH_MAX (OCAP / 8)
#define LD0 DEAD_MAX                 // lists: dead legs
#define BD0 (DEAD_MAX + LCAP)        // lists: dead brains
#define BR0 (DEAD_MAX + LCAP + BCAP) // lists: birth requests

// core0.w flags
#define F_ALIVE 1u
#define F_MOBILE 2u
#define F_BRAIN 4u

// Actions (for colours, animation and stats)
#define A_EAT 0u
#define A_HUNT 1u
#define A_FLEE 2u
#define A_BASK 3u
#define A_WANDER 4u
#define A_REST 5u
#define A_FLOCK 6u

// core0 = (packed position, energy (float bits), age (16 bits) | development x 65535 << 16,
//          flags | canopy layer << 3 | cover contribution << 16)
// core1 = life-history genes, core3 = body plan (8 bits each)
// core2 = (leg slot, brain slot, generation, last action)
layout(set = 0, binding = 0, std430) buffer Core0 { uvec4 core0[]; };
layout(set = 0, binding = 1, std430) buffer Core1 { uvec4 core1[]; };
layout(set = 0, binding = 2, std430) buffer Core2 { uvec4 core2[]; };
layout(set = 0, binding = 3, std430) buffer Damage { uint damage[]; };   // energy x 1000, applied by the victim
// Leg pool: (owner organism, heading, speed in cells/tick, memory) - floats as bits.
layout(set = 0, binding = 4, std430) buffer Legs { uvec4 legs[]; };
layout(set = 0, binding = 5, std430) buffer Brains { uint brains[]; };
// Spatial hash of the mobile organisms, rebuilt at the start of every tick:
// (organism, packed position, phenotype, half2(energy, speed)).
layout(set = 0, binding = 6, std430) buffer GridCount { int grid_count[]; };
layout(set = 0, binding = 7, std430) buffer GridSlot { uvec4 grid_slot[]; };
layout(set = 0, binding = 8, std430) buffer Fert { float fert[]; };      // < 0: water
layout(set = 0, binding = 9, std430) buffer Height { float height[]; };
layout(set = 0, binding = 10, std430) buffer Meat { int meat[]; };       // carrion x PS
layout(set = 0, binding = 11, std430) buffer Cover { int cover[]; };     // 3 canopy layers per cell, x1000
layout(set = 0, binding = 12, std430) buffer OFree { uint ofree[]; };
layout(set = 0, binding = 13, std430) buffer LFree { uint lfree[]; };
layout(set = 0, binding = 14, std430) buffer BFree { uint bfree[]; };
// 0 organism free-stack size, 1 claimed, 2 births, 3 deaths (stats), 4 high-water
// mark, 5 dead-list length, 6 birth requests, 7 organisms counted by the last sort;
// 8-11 the same for legs (size, claimed, hwm, dead), 12-15 for brains;
// 16-23 modules gained / lost at birth (legs, brain, mouth, leaves: +, -);
// 24-29 energy flows (see flow_add); 30 max generation; 31 / 32 3D instances
// written (mobile / sessile); 33 settled (mobile -> rooted in life); 34 uprooted.
layout(set = 0, binding = 15, std430) buffer Counters { int counters[]; };
layout(set = 0, binding = 16, std430) buffer Stats { uint stats[]; };
layout(set = 0, binding = 17, rgba8) uniform writeonly image2D view;
layout(set = 0, binding = 18, std430) buffer Tmp { uint tmp[]; };
layout(set = 0, binding = 19, std430) buffer PPerm { uint pperm[]; };
layout(set = 0, binding = 20, std430) buffer Offsets { uint offsets[]; };
layout(set = 0, binding = 21, std430) buffer BlockSums { uint block_sums[]; };
// Per cell: (first organism, count) in the storage order of the last sort.
layout(set = 0, binding = 22, std430) buffer PCell { uvec2 pcell[]; };
layout(set = 0, binding = 23, std430) buffer PCount { uint pcount[]; };
layout(set = 0, binding = 24, std430) buffer Lists { uint lists[]; };
// 3D view: pose before the last move of each leg-pool slot (packed position,
// heading bits); the viewer; body-rig MultiMesh buffers (12 floats row-major
// transform, 4 colour, 4 custom) for mobile and sessile organisms.
layout(set = 0, binding = 25, std430) buffer LegPrev { uvec2 legprev[]; };
struct Viewer {
	vec2 pos;          // player position in cells
	float radius;      // mobile organisms are drawn this far (m)
	float phase;       // 0..1 progress towards the next tick (interpolation)
	uint flags3d;      // 1 in the 3D view
	uint pad_a;
	uint pad_b;
	uint pad_c;
};
layout(set = 0, binding = 26, std430) buffer ViewerBuf { Viewer viewer; };
layout(set = 0, binding = 27, std430) buffer MInst { float minst[]; };
layout(set = 0, binding = 28, std430) buffer SInst { float sinst[]; };
layout(set = 0, binding = 32, std430) buffer Core3 { uvec4 core3[]; };
// Trampling by mobile organisms (x100, decays), litter from dead sessile organisms
// (x PS, eaten by grazers and sessile feeders, decays), and the tick each cell
// last burned.
layout(set = 0, binding = 33, std430) buffer Trample { int trample[]; };
layout(set = 0, binding = 34, std430) buffer Litter { int litter[]; };
layout(set = 0, binding = 35, std430) buffer Burn { uint burn[]; };

layout(push_constant, std430) uniform Params {
	uint tick;
	uint seed;
	uint init_mode;       // 0 primordial, 1 seeded
	uint color_mode;
	uint show_fields;
	uint fire_pos;        // FIRE: packed centre
	float fire_radius;    // FIRE: radius (m)
	uint pad2;
	float sun_energy;     // energy per m2 of land per tick
	float compute_cost;   // energy per unit of GPU work (~1 ns on the reference GPU)
	float season_strength;
	float season_length;
	float mutation_scale;
	float organ_jump;     // chance per birth of a macro-mutation (module or switch)
	float metabolism;
	float move_cost;
	float attack_power;
	float meat_decay;
	float plant_efficiency;
	float meat_efficiency;
	float vision_cost;
	float detox_cost;
	float max_age;
	float kin_distance;
	float jc_strength;      // seedling failure per same-lineage adult nearby (Janzen-Connell)
	float trample_strength; // damage to low plants from running animals
	float climate_strength; // how much being off the preferred temperature costs
	float pad_f;
} pc;

// ---- Helpers ---------------------------------------------------------------
const float PI = 3.14159265;
#define PS 10000.0

uint gidx() { return gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u; }
uint pcg(uint v) {
	uint state = v * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}
float rnd(inout uint s) { s = pcg(s); return float(s) * (1.0 / 4294967296.0); }
float gauss(inout uint s) {
	float u1 = max(rnd(s), 1e-7);
	float u2 = rnd(s);
	return sqrt(-2.0 * log(u1)) * cos(2.0 * PI * u2);
}
int wrapi(int v) { return ((v % WORLD) + WORLD) % WORLD; }
uint cell_at(ivec2 c) { return uint(wrapi(c.y) * WORLD + wrapi(c.x)); }
uint cell_of(vec2 p) { return cell_at(ivec2(floor(p))); }
vec2 wrap_pos(vec2 p) { return mod(p, float(WORLD)); }
vec2 tdelta(vec2 a, vec2 b) { vec2 d = b - a; return d - float(WORLD) * round(d / float(WORLD)); }
float bearing(vec2 d, float heading) {
	float a = atan(d.y, d.x) - heading;
	return (mod(a + PI, 2.0 * PI) - PI) / PI;
}
ivec2 bucket_coord(vec2 p) { return ivec2(floor(p / float(BUCKET))); }
uint bucket_at(ivec2 b) { return uint(((b.y % BW) + BW) % BW * BW + ((b.x % BW) + BW) % BW); }
uint pack_pos(vec2 p) {
	uvec2 q = uvec2(clamp(p * (65536.0 / float(WORLD)), vec2(0.0), vec2(65535.0)));
	return q.x | (q.y << 16);
}
vec2 unpack_pos(uint v) { return (vec2(v & 0xffffu, v >> 16) + 0.5) * (float(WORLD) / 65536.0); }
vec3 hue2rgb(float h, float s, float v) {
	vec3 k = clamp(abs(mod(h * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
	return v * mix(vec3(1.0), k, s);
}
float hash2(ivec2 p, uint salt) { return float(pcg(uint(p.x) * 1973u ^ pcg(uint(p.y) * 9277u + salt))) * (1.0 / 4294967296.0); }
float vnoise(vec2 p, int period, uint salt) {
	ivec2 i = ivec2(floor(p));
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	ivec2 i0 = ivec2(i.x % period, i.y % period);
	ivec2 i1 = ivec2((i.x + 1) % period, (i.y + 1) % period);
	return mix(mix(hash2(i0, salt), hash2(ivec2(i1.x, i0.y), salt), f.x),
			mix(hash2(ivec2(i0.x, i1.y), salt), hash2(i1, salt), f.x), f.y);
}
float fbm(vec2 uv, int base_freq, uint salt) {
	float sum = 0.0, amp = 0.5, norm = 0.0;
	int freq = base_freq;
	for (int o = 0; o < 6; o++) {
		sum += vnoise(uv * float(freq), freq, salt + uint(o) * 101u) * amp;
		norm += amp;
		amp *= 0.5;
		freq *= 2;
	}
	return sum / norm;
}
float terrain_height(float h) { return h >= 0.42 ? (h - 0.42) * (40.0 + 12.0 * CELL) : (h - 0.42) * 50.0; }

// Genes: 16 bytes in a uvec4.
float gene(uvec4 g, int k) { return float((g[k >> 2] >> ((k & 3) * 8)) & 255u) / 255.0; }
uvec4 set_gene(uvec4 g, int k, float v) {
	uint b = uint(clamp(v, 0.0, 1.0) * 255.0 + 0.5);
	g[k >> 2] = bitfieldInsert(g[k >> 2], b, (k & 3) * 8, 8);
	return g;
}
// Age (ticks, 16 bits) and development (0..1, 16 bits) share core0.z.
uint c_age(uvec4 c0) { return c0.z & 0xffffu; }
float c_dev(uvec4 c0) { return float(c0.z >> 16) / 65535.0; }
uint pack_age(uint age, float dev) { return min(age, 65535u) | (uint(clamp(dev, 0.0, 1.0) * 65535.0) << 16); }

// Int8 weights, four per word.
vec4 unpack_w(uint w) {
	ivec4 v = ivec4(int(w) << 24, int(w) << 16, int(w) << 8, int(w)) >> 24;
	return vec4(v) * (1.0 / 32.0);
}
uint mutate_word(uint word, float p, inout uint rs) {
	for (int k = 0; k < 4; k++) {
		if (rnd(rs) < p) {
			int b = bitfieldExtract(int(word), k * 8, 8);
			b = clamp(b + int(round(gauss(rs) * 14.0)), -127, 127);
			word = bitfieldInsert(word, uint(b) & 255u, k * 8, 8);
		}
	}
	return word;
}
uint random_word(inout uint rs, float sd) {
	uint w = 0u;
	for (int k = 0; k < 4; k++) w = bitfieldInsert(w, uint(clamp(int(round(gauss(rs) * sd)), -127, 127)) & 255u, k * 8, 8);
	return w;
}

// A new brain starts by wiring the reflexes (brains grew out of reflex circuits),
// plus noise: neuron 0 steers (towards food and prey, away from threats),
// neuron 1 sets the pace (hunger, danger), neuron 2 attacks close prey. Extra
// neurons start as noise for evolution to use. Weights: int8 / 32.
uint wbytes(float a, float b, float c, float d) {
	ivec4 q = clamp(ivec4(round(vec4(a, b, c, d) * 32.0)), -127, 127);
	return (uint(q.x) & 255u) | ((uint(q.y) & 255u) << 8) | ((uint(q.z) & 255u) << 16) | ((uint(q.w) & 255u) << 24);
}
void instinct_brain(uint base, inout uint rs) {
	for (uint w = 0u; w < uint(BRAIN_WORDS); w++) brains[base + w] = random_word(rs, 5.0);
	// Hidden neuron h owns words 4h..4h+3 over x0 (satiety, food here, food ahead, food left-right),
	// x1 (carrion, -, threat, threat bearing), x2 (prey, prey bearing, kin, kin bearing),
	// x3 (memory, sunlight, noise, bias).
	brains[base + 0u] = wbytes(0.0, 0.0, 0.0, 3.0);
	brains[base + 1u] = wbytes(0.0, 0.0, 0.0, -3.0);
	brains[base + 2u] = wbytes(0.0, 2.0, 0.0, 0.0);
	brains[base + 3u] = wbytes(0.0, 0.0, 0.5, 0.0);
	brains[base + 4u] = wbytes(-1.5, -2.0, 0.0, 0.0);
	brains[base + 5u] = wbytes(0.0, 0.0, 3.0, 0.0);
	brains[base + 6u] = wbytes(1.0, 0.0, 0.0, 0.0);
	brains[base + 7u] = wbytes(0.0, -1.0, 0.0, 0.5);
	brains[base + 8u] = wbytes(-2.0, 0.0, 0.0, 0.0);
	brains[base + 9u] = wbytes(0.0, 0.0, 0.0, 0.0);
	brains[base + 10u] = wbytes(4.0, 0.0, 0.0, 0.0);
	brains[base + 11u] = wbytes(0.0, 0.0, 0.0, -0.5);
	// Outputs (turn, speed, attack, memory): 2 words each over h0..h3 and h4..h6 + bias.
	brains[base + 28u] = wbytes(3.0, 0.0, 0.0, 0.0);
	brains[base + 29u] = wbytes(0.0, 0.0, 0.0, 0.0);
	brains[base + 30u] = wbytes(0.0, 3.0, 0.0, 0.0);
	brains[base + 31u] = wbytes(0.0, 0.0, 0.0, 0.3);
	brains[base + 32u] = wbytes(0.0, 0.0, 3.0, 0.0);
	brains[base + 33u] = wbytes(0.0, 0.0, 0.0, 0.0);
}

// ---- Development: body plan + age + energy -> abilities ------------------------
struct Body {
	float anchor, axis, sym, act;       // switches (adult values after metamorphosis)
	float photo, mouth, sense, defence; // modules (0 = absent)
	float nseg, apps, applen;           // segments, appendage pairs, appendage length
	float mobil;                        // movement ability 0..1
	float gf;                           // growth: energy fill (indeterminate) or development (determinate)
	bool legs, meta;
};
float module_of(float v, float t) { return v >= t ? v : 0.0; }
Body develop(uvec4 m, float age, float dev, float fill) {
	Body b;
	float mt = gene(m, M_META);
	b.meta = mt >= T_META && age >= mt * 3000.0;
	b.anchor = b.meta ? gene(m, M_ADULT_ANCHOR) : gene(m, M_ANCHOR);
	b.act = b.meta ? gene(m, M_ADULT_ACT) : gene(m, M_ACT);
	b.axis = gene(m, M_AXIS);
	b.sym = gene(m, M_SYM);
	b.photo = module_of(gene(m, M_SURFACE), T_PHOTO);
	b.mouth = module_of(gene(m, M_FEED), T_MOUTH);
	b.sense = module_of(gene(m, M_SENSOR), T_EYES);
	b.defence = gene(m, M_PROTECT);
	b.nseg = 1.0 + floor(gene(m, M_SEGS) * 5.99);
	b.apps = floor(gene(m, M_APPS) * 4.99);
	b.applen = gene(m, M_APPLEN);
	// Muscular appendages move the body, unless it is rooted. Radial bodies and
	// upright ones move less efficiently.
	float power = b.apps * 0.25 * (0.3 + b.applen);
	b.mobil = clamp(1.4 * power * b.act * (1.0 - b.anchor) * (1.0 - 0.4 * b.sym) * (1.0 - 0.3 * b.axis) - 0.05, 0.0, 1.0);
	b.legs = b.mobil >= T_LEGS;
	b.gf = mix(sqrt(clamp(fill, 0.0, 1.0)), dev, gene(m, M_DETERM));
	return b;
}
Body body_of(uvec4 c0, uvec4 m, float emax) {
	return develop(m, float(c_age(c0)), c_dev(c0), uintBitsToFloat(c0.y) / max(emax, 0.01));
}

float body_len(float s) { return 0.4 + 2.1 * s; }                          // metres (mobile)
float e_max(float s) { return 1.0 + 20.0 * s * s * s; }                     // energy capacity
float s_height(float s, float fill) { return (0.2 + 13.8 * s * s * s) * (0.3 + 0.7 * sqrt(clamp(fill, 0.0, 1.0))); }
float s_crown(float s, float fill) { return (2.0 + 3.0 * s * s) * (0.4 + 0.6 * sqrt(clamp(fill, 0.0, 1.0))); }
// Sessile shape: upright axes grow tall, creeping ones spread; branches widen the crown.
float sess_height(float s, Body b) { return s_height(s, b.gf * b.gf) * (0.25 + 0.75 * b.axis); }
float sess_crown(float s, Body b) {
	return s_crown(s, b.gf * b.gf) * (0.7 + 0.5 * min(b.apps * 0.25 * (0.3 + b.applen), 1.0)) * (1.0 + 0.15 * (1.0 - b.axis));
}
uint layer_for(float h) { return h < 1.0 ? 0u : (h < 3.0 ? 1u : 2u); }
float lifespan(float s, bool mobile) { return mobile ? pc.max_age * (0.6 + 0.4 * body_len(s)) : min(1500.0 + 40000.0 * s * s * s, 60000.0); }
float maturity(float s, bool mobile) { return mobile ? 20.0 : 150.0 + 4000.0 * s * s * s; }
int neurons(uvec4 g) { float b = gene(g, G_BRAIN); return b < T_BRAIN ? 0 : clamp(int(b * 8.0), 1, 7); }
float light_at(uint c, uint layer) {
	float l = 1.0;
	if (layer < 2u) l *= 1.0 - min(float(cover[c * 3u + 2u]) / 1000.0, 0.95);
	if (layer < 1u) l *= 1.0 - min(float(cover[c * 3u + 1u]) / 1000.0, 0.9);
	return l;
}
float season_at(uint c) {
	float y = float(c / uint(WORLD)) / float(WORLD);
	return max(1.0 + pc.season_strength * sin(2.0 * PI * (float(pc.tick) / pc.season_length + y)), 0.0);
}
// Climate: warm around the equator line (y = 0), cold around y = 0.5 and on
// mountains. Organisms do best near their preferred temperature.
float temperature_at(uint c) {
	float y = float(c / uint(WORLD)) / float(WORLD);
	return clamp(0.5 + 0.35 * cos(2.0 * PI * y) - max(height[c], 0.0) / 90.0, 0.0, 1.0);
}
float thermal_fit(uvec4 g, uint c) {
	float d = (temperature_at(c) - gene(g, G_TEMP)) / 0.3;
	return 1.0 - pc.climate_strength * (1.0 - exp(-d * d));
}
float edibility(float defence, float detox) { return clamp(1.0 - 1.5 * max(defence - detox, 0.0), 0.05, 1.0); }
float power_of(float s, float mouth, float carni) { return body_len(s) * (0.3 + mouth) * (0.4 + carni); }
// Neighbour phenotype: size, carnivory, hue (8 bits each), mouth, photosynthesis (4 bits).
uint pack_pheno(uvec4 g, Body b) {
	return uint(gene(g, G_SIZE) * 255.0) | (uint(gene(g, G_CARNI) * 255.0) << 8) | (uint(gene(g, G_HUE) * 255.0) << 16)
			| (uint(b.mouth * 15.0) << 24) | (uint(b.photo * 15.0) << 28);
}
float ph_size(uint p) { return float(p & 255u) / 255.0; }
float ph_carni(uint p) { return float((p >> 8) & 255u) / 255.0; }
float ph_hue(uint p) { return float((p >> 16) & 255u) / 255.0; }
float ph_mouth(uint p) { return float((p >> 24) & 15u) / 15.0; }
float gdist(uint a, uint b) {
	float dh = abs(ph_hue(a) - ph_hue(b));
	return min(dh, 1.0 - dh) * 2.0 + abs(ph_carni(a) - ph_carni(b)) + abs(ph_size(a) - ph_size(b)) * 0.5;
}
float f_energy(uvec4 c0) { return uintBitsToFloat(c0.y); }
vec2 c_pos(uvec4 c0) { return unpack_pos(c0.x); }
float sess_emax(float s, uint c) { return e_max(s) * pow(max(fert[c], 0.05), 0.5 + s); }

// Energy flows (reset by STATS): 24 sun captured x10, 25 sessile compute x1000,
// 26 sessile upkeep x10, 27 mobile intake x100, 28 mobile compute x100, 29 mobile upkeep x100.
void flow_add(int k, float v, float scale) {
	float sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(counters[k], int(sum * scale + 0.5));
}

// A dying organism: frees its organs and its slot, leaves carrion if mobile.
void die(uint i, uvec4 c0, uvec4 c2, float s) {
	uint fl = c0.w;
	if ((fl & F_MOBILE) == 0u) {
		uint contrib = fl >> 16;
		if (contrib > 0u) atomicAdd(cover[cell_of(c_pos(c0)) * 3u + ((fl >> 3) & 3u)], -int(contrib));
		atomicAdd(litter[cell_of(c_pos(c0))], int((max(f_energy(c0), 0.0) + 0.3 + 0.5 * s) * 0.6 * PS));
	} else {
		atomicAdd(meat[cell_of(c_pos(c0))], int((max(f_energy(c0), 0.0) + 0.3 + 0.5 * s) * PS));
	}
	if (c2.x != NONE) {
		legs[c2.x].x = NONE;
		lists[LD0 + uint(atomicAdd(counters[11], 1))] = c2.x;
	}
	if (c2.y != NONE) lists[BD0 + uint(atomicAdd(counters[15], 1))] = c2.y;
	core0[i] = uvec4(0u);
	core2[i] = uvec4(NONE, NONE, 0u, 0u);
	lists[uint(atomicAdd(counters[5], 1))] = i;
	atomicAdd(counters[3], 1);
}

// Ask to reproduce (handled by BIRTH after the passes).
void request_birth(uint i) {
	if (counters[6] >= min(counters[0], BIRTH_MAX)) return;
	int k = atomicAdd(counters[6], 1);
	if (k < BIRTH_MAX) lists[BR0 + uint(k)] = i;
}

// Take a leg slot (and a brain slot if the genes ask for one); false if the pool is full.
bool grow_legs(uint i, uvec4 g, vec2 pos, inout uint rs, out uint leg, out uint brn) {
	leg = NONE;
	brn = NONE;
	int lk = atomicAdd(counters[9], 1);
	int lf = counters[8];
	if (lk >= lf) return false;
	leg = lfree[lf - 1 - lk];
	atomicMax(counters[10], int(leg) + 1);
	float heading = rnd(rs) * 2.0 * PI;
	legs[leg] = uvec4(i, floatBitsToUint(heading), 0u, 0u);
	legprev[leg] = uvec2(pack_pos(pos), floatBitsToUint(heading));
	if (neurons(g) > 0) {
		int bk = atomicAdd(counters[13], 1);
		int bf = counters[12];
		if (bk < bf) {
			brn = bfree[bf - 1 - bk];
			atomicMax(counters[14], int(brn) + 1);
		}
	}
	return true;
}

// ---- Colours (2D) ----------------------------------------------------------
vec3 life_color(uvec4 g, uvec4 c0, Body b) {
	int n = neurons(g);
	bool brain = (c0.w & F_BRAIN) != 0u;
	if (pc.color_mode == 1u) return hue2rgb(gene(g, G_HUE), 0.75, 1.0);
	if (pc.color_mode == 2u) { // organs: blue = brain size, white = eyes, dark = neither
		vec3 c = b.sense > 0.0 ? vec3(0.85) : vec3(0.35, 0.35, 0.4);
		return mix(c, vec3(0.2, 0.5, 1.0), brain ? float(n) / 7.0 : 0.0);
	}
	if (pc.color_mode == 3u) {
		float e = f_energy(c0) / e_max(gene(g, G_SIZE));
		return mix(vec3(0.9, 0.1, 0.1), vec3(0.1, 1.0, 0.3), clamp(e, 0.0, 1.0));
	}
	if (pc.color_mode == 4u) { // body plan: rooted upright = green, creeping = teal, free = grey -> orange (muscles), radial = purple tint
		vec3 rooted = mix(vec3(0.1, 0.6, 0.6), vec3(0.25, 0.85, 0.2), b.axis);
		vec3 free_ = mix(vec3(0.6), vec3(1.0, 0.55, 0.1), b.act);
		return mix(mix(free_, rooted, b.anchor), vec3(0.7, 0.3, 0.9), 0.35 * b.sym);
	}
	// Lifestyle: green = sunlight, yellow = eats plants, red = eats animals; bluish = brainy.
	float carni = gene(g, G_CARNI);
	vec3 c = b.photo * vec3(0.2, 0.95, 0.25) + b.mouth * (1.0 - carni) * vec3(1.0, 0.85, 0.15) + b.mouth * carni * vec3(1.0, 0.15, 0.1);
	float w = b.photo + b.mouth;
	c = w > 0.0 ? c / w : vec3(0.6);
	return mix(c, vec3(0.55, 0.75, 1.0), brain ? 0.45 * float(n) / 7.0 : 0.0);
}

// =============================================================================
#ifdef K_INIT_FIELD
void main() {
	uint c = gidx();
	if (c >= uint(WORLD * WORLD)) return;
	vec2 uv = (vec2(c % uint(WORLD), c / uint(WORLD)) + 0.5) / float(WORLD);
	uint salt = pc.seed * 7919u;
	float h = fbm(uv, 4, salt);
	float f;
	if (h < 0.42) {
		f = -1.0 + h;
	} else {
		float lush = fbm(uv, 6, salt + 5000u);
		float shore = 1.0 - smoothstep(0.42, 0.5, h);
		f = clamp(0.1 + 0.9 * smoothstep(0.3, 0.7, lush) + 0.35 * shore, 0.05, 1.0);
	}
	fert[c] = f;
	height[c] = terrain_height(h);
	meat[c] = 0;
	cover[c * 3u] = 0;
	cover[c * 3u + 1u] = 0;
	cover[c * 3u + 2u] = 0;
	pcell[c] = uvec2(0u);
	pcount[c] = 0u;
	trample[c] = 0;
	litter[c] = 0;
	burn[c] = 0xffffffffu;
	if (c < uint(NB)) grid_count[c] = 0;
}
#endif

// Initial organisms: NMOB mobile founders (seeded mode) then sessile ones.
#ifdef K_INIT_ORGS
void main() {
	uint k = gidx();
	if (k >= uint(OCAP)) return;
	uint n0 = min(uint(NINIT), uint(OCAP));
	uint nm = min(uint(NMOB), n0);
	if (k == 0u) {
		for (int j = 0; j < 40; j++) counters[j] = 0;
		counters[0] = OCAP - int(n0);
		counters[4] = int(n0);
		counters[8] = LCAP - int(nm);
		counters[10] = int(nm);
		counters[12] = BCAP - int(nm);
		counters[14] = int(nm);
	}
	damage[k] = 0u;
	if (k >= n0) {
		ofree[uint(OCAP) - 1u - k] = k;
		core0[k] = uvec4(0u);
		core1[k] = uvec4(0u);
		core2[k] = uvec4(NONE, NONE, 0u, 0u);
		core3[k] = uvec4(0u);
		return;
	}
	uint rs = pcg(k * 2246822519u + pc.seed * 7u + 3u);
	vec2 p = vec2(0.0);
	float f = -1.0;
	for (int t = 0; t < 32; t++) {
		p = vec2(rnd(rs), rnd(rs)) * float(WORLD);
		f = fert[cell_of(p)];
		if (f > 0.0 && rnd(rs) < f + 0.2) break;
	}
	vec2 uv = p / float(WORLD);
	uint salt = pc.seed * 7919u;
	float hue = fract(fbm(uv, 3, salt + 9000u) * 2.5 + gauss(rs) * 0.02);
	uvec4 g = uvec4(0u);
	g = set_gene(g, G_HUE, hue);
	g = set_gene(g, G_MUT, 0.05 + 0.03 * rnd(rs));
	g = set_gene(g, G_GROWTH, 0.4 + 0.2 * rnd(rs));
	g = set_gene(g, G_REPRO, 0.5 + 0.2 * rnd(rs));
	g = set_gene(g, G_CHILD, 0.25 + 0.1 * rnd(rs));
	g = set_gene(g, G_DISPERSE, 0.3 + 0.4 * rnd(rs));
	g = set_gene(g, G_CARNI, rnd(rs));
	g = set_gene(g, G_TEMP, temperature_at(cell_of(p)) + gauss(rs) * 0.05);
	uvec4 m = uvec4(0u);
	m = set_gene(m, M_SLENDER, 0.3 + 0.4 * rnd(rs));
	m = set_gene(m, M_PROTECT, 0.05 * rnd(rs));
	bool mobile = k < nm;
	if (pc.init_mode == 0u) {
		// Primordial: small rooted sun-eaters, loosely radial, rigid, no mouth, eyes or brain.
		g = set_gene(g, G_SIZE, 0.02 + 0.1 * rnd(rs));
		g = set_gene(g, G_CARNI, 0.5 * rnd(rs));
		m = set_gene(m, M_ANCHOR, 0.8 + 0.2 * rnd(rs));
		m = set_gene(m, M_AXIS, 0.5 + 0.3 * rnd(rs));
		m = set_gene(m, M_SYM, 0.6 + 0.4 * rnd(rs));
		m = set_gene(m, M_DETERM, 0.3 * rnd(rs));
		m = set_gene(m, M_ACT, 0.1 * rnd(rs));
		m = set_gene(m, M_SEGS, 0.15 * rnd(rs));
		m = set_gene(m, M_APPS, 0.3 * rnd(rs));
		m = set_gene(m, M_APPLEN, 0.2 + 0.3 * rnd(rs));
		m = set_gene(m, M_SURFACE, 0.3 + 0.4 * rnd(rs));
	} else if (!mobile) {
		// Seeded plants: rooted, upright, radial, rigid; growth forms by region.
		float st = clamp(fbm(uv, 5, salt + 12000u) * 1.8 - 0.55 + (f - 0.5) * 0.5 + (rnd(rs) - 0.5) * 0.3, 0.0, 1.0);
		g = set_gene(g, G_SIZE, st);
		m = set_gene(m, M_ANCHOR, 0.95);
		m = set_gene(m, M_AXIS, 0.75 + 0.25 * rnd(rs));
		m = set_gene(m, M_SYM, 0.8 + 0.2 * rnd(rs));
		m = set_gene(m, M_DETERM, 0.1 * rnd(rs));
		m = set_gene(m, M_SEGS, 0.2 + 0.6 * st);
		m = set_gene(m, M_APPS, 0.3 + 0.5 * st);
		m = set_gene(m, M_APPLEN, 0.4 + 0.3 * rnd(rs));
		m = set_gene(m, M_SURFACE, 0.6 + 0.4 * rnd(rs));
	} else {
		// Seeded animals: free, horizontal, bilateral, determinate, muscular;
		// herbivores and some carnivores, half with a brain.
		bool carn = rnd(rs) < 0.08;
		g = set_gene(g, G_SIZE, carn ? 0.5 + 0.2 * rnd(rs) : 0.3 + 0.3 * rnd(rs));
		g = set_gene(g, G_CARNI, carn ? 0.8 + 0.2 * rnd(rs) : 0.15 * rnd(rs));
		g = set_gene(g, G_BRAIN, rnd(rs) < 0.5 ? 0.5 + 0.2 * rnd(rs) : 0.0);
		g = set_gene(g, G_REPRO, 0.6);
		g = set_gene(g, G_SOCIAL, 0.3 * rnd(rs));
		g = set_gene(g, G_HUE, fract(hue + (carn ? 0.5 : 0.0)));
		m = set_gene(m, M_ANCHOR, 0.0);
		m = set_gene(m, M_AXIS, 0.05 * rnd(rs));
		m = set_gene(m, M_SYM, 0.1 * rnd(rs));
		m = set_gene(m, M_DETERM, 0.85 + 0.15 * rnd(rs));
		m = set_gene(m, M_ACT, 0.85 + 0.15 * rnd(rs));
		m = set_gene(m, M_SEGS, 0.2 + 0.3 * rnd(rs));
		m = set_gene(m, M_APPS, 0.45 + 0.1 * rnd(rs));
		m = set_gene(m, M_APPLEN, 0.5 + 0.3 * rnd(rs));
		m = set_gene(m, M_FEED, 0.5 + 0.3 * rnd(rs));
		m = set_gene(m, M_SENSOR, carn ? 0.8 + 0.2 * rnd(rs) : 0.3 + 0.3 * rnd(rs)); // hunters see far
		m = set_gene(m, M_PROTECT, 0.1 * rnd(rs));
	}
	m = set_gene(m, M_ADULT_ANCHOR, gene(m, M_ANCHOR));
	m = set_gene(m, M_ADULT_ACT, gene(m, M_ACT));
	float s = gene(g, G_SIZE);
	uint flags = F_ALIVE;
	uint leg = NONE, br = NONE;
	if (mobile) {
		flags |= F_MOBILE;
		leg = k;
		float heading = rnd(rs) * 2.0 * PI;
		legs[k] = uvec4(k, floatBitsToUint(heading), 0u, 0u);
		legprev[k] = uvec2(pack_pos(p), floatBitsToUint(heading));
		if (neurons(g) > 0) {
			flags |= F_BRAIN;
			br = k;
		}
	}
	core0[k] = uvec4(pack_pos(p), floatBitsToUint(e_max(s) * (mobile ? 0.62 : 0.3)),
			pack_age(uint(rnd(rs) * 300.0), mobile ? 1.0 : 0.5), flags);
	core1[k] = g;
	core2[k] = uvec4(leg, br, 0u, 0u);
	core3[k] = m;
}
#endif

// Organ pools: free stacks, and reflex-wired brains.
#ifdef K_INIT_POOLS
void main() {
	uint t = gidx();
	uint nm = min(uint(NMOB), min(uint(NINIT), uint(OCAP)));
	if (t < uint(LCAP)) {
		if (t >= nm) {
			legs[t] = uvec4(NONE, 0u, 0u, 0u);
			lfree[uint(LCAP) - 1u - t] = t;
		}
	}
	if (t < uint(BCAP)) {
		if (t >= nm) bfree[uint(BCAP) - 1u - t] = t;
		uint rs = pcg(t * 7331u + pc.seed * 13u);
		instinct_brain(t * uint(BRAIN_WORDS), rs);
	}
}
#endif

